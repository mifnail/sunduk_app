# Скопируйте в .env и заполните своими ключами.
# .env НЕ коммитится (см. .gitignore).

# --- Telegram ---
TG_TOKEN=

# --- VK ---
VK_TOKEN=
VK_GROUP_ID=

# --- MAX ---
# MAX_TOKEN — токен чат-бота MAX (business.max.ru/self → Чат-боты → Настроить)
MAX_TOKEN=
# MAX_ENDPOINT — базовый URL API MAX (по умолчанию https://platform-api2.max.ru)
MAX_ENDPOINT=https://platform-api2.max.ru
# MAX_ADMIN_ID — через запятую user_id операторов, которым разрешены команды бота
MAX_ADMIN_ID=

# --- Flask ---
SECRET_KEY=change-me
ORDERS_DB=instance/orders.db